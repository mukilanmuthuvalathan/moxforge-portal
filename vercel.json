{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!llms\\.txt|ard\\.json|ai-catalog\\.json|\\.well-known/.*|robots\\.txt|sitemap\\.xml|site\\.webmanifest|google3c137e9371f21c82\\.html|assets/.*|images/.*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(llms\\.txt|\\.well-known/llms\\.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(ard\\.json|\\.well-known/ard\\.json|ai-catalog\\.json|\\.well-known/ai-catalog\\.json)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
